# ==========================================
# Root & Environment Variables
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
!server/.env.example
!client/.env.example

# ==========================================
# Client (Node.js / React / Vite)
# ==========================================
node_modules/
client/node_modules/
dist/
dist-ssr/
client/dist/
client/dist-ssr/
build/
client/build/
.pnp
.pnp.js

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Server (Go / Gin / GORM)
# ==========================================
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
server/*.exe
bin/
server/bin/
vendor/
server/vendor/

# ==========================================
# IDE & System Files
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ==========================================
# Database Dumps (never commit these)
# ==========================================
*.sql
*.sql.gz
*_dump.sql
