[mysqld]
# Server Identification
server-id = 1
report-host = mysql-primary

# Binary Logging & GTID Configuration (Essential for Replication & Failover)
log_bin = /var/log/mysql/mysql-bin.log
binlog_format = ROW
binlog_row_image = FULL
gtid_mode = ON
enforce_gtid_consistency = ON
binlog_expire_logs_seconds = 604800
max_binlog_size = 100M

# Crash Safety & Durability
sync_binlog = 1
innodb_flush_log_at_trx_commit = 1

# Connection & Character Settings
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
max_connections = 300
max_connect_errors = 10000

# Semi-Synchronous Replication (Master plugin)
# Plugin is loaded dynamically or compiled in MySQL 8
# rpl_semi_sync_master_enabled = 1
# rpl_semi_sync_master_timeout = 2000
