[mysqld]
# Server Identification (Overridden in container or environment if dynamic)
server-id = 2
report-host = mysql-replica

# GTID & Binary Logging on Replicas (Allows replica promotion & re-replication)
log_bin = /var/log/mysql/mysql-bin.log
binlog_format = ROW
binlog_row_image = FULL
gtid_mode = ON
enforce_gtid_consistency = ON
binlog_expire_logs_seconds = 604800
max_binlog_size = 100M

# Relay Logging Configuration
relay_log = /var/log/mysql/mysql-relay-bin.log
relay_log_recovery = ON
log_replica_updates = ON

# Read-Only Safeguard (Protects replicas against unintended direct writes)
read_only = ON
super_read_only = ON

# Connection & Character Settings
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
max_connections = 300
max_connect_errors = 10000
