# ==========================================
# Mock-Mate Docker Environment Configuration
# ==========================================

# Database Configuration
MYSQL_ROOT_PASSWORD=jaison
MYSQL_DATABASE=mock_mate
MYSQL_USER=mockmate_user
MYSQL_PASSWORD=mockmate_password
DB_EXTERNAL_PORT=3306

# Server Configuration
SERVER_PORT=8080
GIN_MODE=release
JWT_SECRET=replace_with_a_long_random_secret_token_key_here

# Client Configuration
CLIENT_PORT=80
VITE_API_URL=/api/v1

# Cloudflare Tunnel Token (Optional: if running tunnel via Docker)
# Paste your Cloudflare Zero Trust tunnel token below:
TUNNEL_TOKEN=
