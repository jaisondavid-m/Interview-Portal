# ==========================================
# Mock-Mate Docker Environment Configuration
# ==========================================

# Database Configuration
MYSQL_ROOT_PASSWORD=jaison
MYSQL_DATABASE=mock_mate
MYSQL_USER=mockmate_user
MYSQL_PASSWORD=mockmate_password
DB_EXTERNAL_PORT=3306

# Server Configuration
SERVER_PORT=8080
GIN_MODE=release
JWT_SECRET=replace_with_a_long_random_secret_token_key_here

# Blue-Green Deployment Configuration
BLUE_PORT=8083
GREEN_PORT=8084
BLUE_COLOR=blue
GREEN_COLOR=green
BLUE_VERSION=v1.0.0
GREEN_VERSION=v1.1.0

# Client Configuration
CLIENT_PORT=8081
VITE_API_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=

# Google OAuth Configuration (Optional - for Campus/Google Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Tunnel Token (Optional: if running tunnel via Docker)
# Paste your Cloudflare Zero Trust tunnel token below:
TUNNEL_TOKEN=

# Redis Cache & Rate Limiter Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0